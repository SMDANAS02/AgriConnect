# Environment Configuration for AgriConnect Backend

# Server
PORT=5000
NODE_ENV=development

# Database
# PostgreSQL connection string for Neon / local database
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/agriconnect?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="agriconnect_super_secret_jwt_key_2026_tamilnadu"
